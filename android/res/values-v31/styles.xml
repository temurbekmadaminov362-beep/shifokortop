<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the opening (splash) screen shows the logo on cobalt blue -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_bg</item>
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/ic_bg</item>
    </style>
</resources>
